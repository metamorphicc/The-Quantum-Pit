# ==========================================================================
# Quantum Pit — server environment (Vercel → Project → Settings → Env Vars)
#
# Copy to .env for local `vercel dev`, or set these in the Vercel dashboard.
# .env is gitignored. NEVER commit real secrets. The frontend build reads NONE
# of these — only the api/ functions do — except the optional VITE_QP_* below.
# ==========================================================================

# --- Telegram --------------------------------------------------------------
# Bot API token from @BotFather. (Legacy name BOT_TOKEN is still accepted.)
TELEGRAM_BOT_TOKEN=
# Shared secret you also pass as `secret_token` when registering the webhook.
# Recommended: rejects webhook calls that don't present it.
WEBHOOK_SECRET=
# Optional. Public URL of the Mini App; defaults to the deployment URL.
APP_URL=
# Optional. Absolute URL of the /start banner image.
START_IMAGE_URL=

# --- Base (cosmetic payments in USDC) --------------------------------------
# Wallet that receives cosmetic payments. (Legacy: BASE_COSMETIC_TREASURY_ADDRESS.)
TREASURY_ADDRESS=0xyour_treasury_wallet
# Read-only RPC used to CONFIRM Base transactions server-side.
BASE_RPC_URL=https://mainnet.base.org
# Optional. Address of the deployed QuantumPitDonations contract, if you use it.
DONATION_CONTRACT_ADDRESS=

# --- Payment store (required to take Stars / grant entitlements) -----------
# Upstash Redis / Vercel KV REST credentials. Without these, payment endpoints
# fail closed (they refuse rather than trust the client). Either name pair works.
KV_REST_API_URL=
KV_REST_API_TOKEN=
# or, for Upstash native:
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# --- Contract deploy (used only by contracts/, not the app) ----------------
# A dedicated deployer key funded with (test)net ETH. Also lives in contracts/.env.
DEPLOYER_PRIVATE_KEY=0xyour_deployer_private_key

# --- Optional client overrides (VITE_ prefixed = shipped to the browser) ---
# Leave unset in normal deployments; the client defaults to the /api routes.
# VITE_QP_TELEGRAM_STARS_CHECKOUT_URL=/api/checkout/telegram-stars
# VITE_QP_BASE_COSMETIC_CHECKOUT_URL=/api/checkout/base-cosmetic
# VITE_QP_BASE_VERIFY_URL=/api/checkout/base-verify
# VITE_QP_ENTITLEMENTS_URL=/api/entitlements
