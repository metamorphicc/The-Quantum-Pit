# Foundry deploy secrets — copy to contracts/.env and fill in. NEVER commit the real .env.

# The account that signs the deployment. Use a throwaway/dedicated deployer key,
# funded with a little Base Sepolia ETH from a faucet. No production keys here.
DEPLOYER_PRIVATE_KEY=0xyour_deployer_private_key

# Becomes the contract owner (the address allowed to withdraw donations).
TREASURY_ADDRESS=0xyour_treasury_wallet

# RPC endpoints. The public ones work for a first deploy; swap in your own
# (Alchemy/Infura/QuickNode) for reliability.
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org
BASE_RPC_URL=https://mainnet.base.org

# Optional — only needed for `--verify` on Basescan.
BASESCAN_API_KEY=
